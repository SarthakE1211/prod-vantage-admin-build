<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the Vantage admin panel.

  The Node API sets its own security headers, but the panel is static content served by
  IIS, so these three findings can only be closed here:

    Burp DAST #2 (CWE-1021)  - GET /dashboard was frameable: no X-Frame-Options and no
                               frame-ancestors, so it could be loaded in an attacker's
                               iframe and clickjacked.
    Burp DAST #3 (CWE-326)   - http://console.ovationwps.com served content; HSTS alone
                               does not help a first, plaintext visit.
    Burp DAST #4 (CWE-524)   - GET / was cacheable; index.html must not be stored, or a
                               shared machine serves a stale authenticated shell.

  It also carries the Content-Security-Policy that VAPT M-01 asks for. The script-src
  list matches what src/index.html actually loads today (Google Maps, pinned Leaflet) -
  re-check it if that changes. 'unsafe-inline' for styles is required by ng-zorro's
  runtime style injection; scripts do not get it.

  Smoke-test the panel with this deployed before rolling it out: a CSP that is too tight
  shows an empty page rather than an error.
-->
<configuration>
  <system.webServer>

    <!-- Angular client-side routing: everything that is not a real file goes to index.html -->
    <rewrite>
      <rules>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Angular routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(auth|api)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="Server" />

        <!-- #2 Frameable response -->
        <add name="X-Frame-Options" value="DENY" />

        <!-- #3 Unencrypted communications: 2 years, the value HSTS preload requires -->
        <add name="Strict-Transport-Security" value="max-age=63072000; includeSubDomains; preload" />

        <!-- VAPT M-01: second line of defence behind the sanitiser fix -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' https://maps.googleapis.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://console.ovationwps.com https://preconsole.ovationwps.com https://maps.googleapis.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" />

        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Permissions-Policy" value="geolocation=(self), camera=(), microphone=(), payment=()" />
      </customHeaders>
    </httpProtocol>

    <!-- #4 Cacheable HTTPS response: the app shell must never be stored. Hashed build
         assets keep their own long cache via the static-content defaults. -->
    <location path="index.html">
      <system.webServer>
        <httpProtocol>
          <customHeaders>
            <add name="Cache-Control" value="no-store, no-cache, must-revalidate, private" />
            <add name="Pragma" value="no-cache" />
            <add name="Expires" value="0" />
          </customHeaders>
        </httpProtocol>
      </system.webServer>
    </location>

    <!-- No directory listings, and never serve the source map or config files. -->
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="web.config" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".map" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
